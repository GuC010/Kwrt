#!/bin/sh /etc/rc.common
# Homebox LAN speed-test service for Phicomm N1.
# Disabled by default; LuCI's homebox.enabled flag controls startup.
START=95
STOP=10
USE_PROCD=1

start_service() {
    enabled="$(uci -q get homebox.@homebox[0].enabled 2>/dev/null)"
    [ "$enabled" = "1" ] || return 0

    host="$(uci -q get homebox.@homebox[0].host 2>/dev/null)"
    port="$(uci -q get homebox.@homebox[0].port 2>/dev/null)"

    [ -n "$host" ] || host="192.168.10.251"
    [ -n "$port" ] || port="3300"

    case "$host" in
        192.168.10.251|127.0.0.1) ;;
        *)
            logger -t homebox "Refusing unexpected bind address: $host"
            return 1
            ;;
    esac

    case "$port" in
        ''|*[!0-9]*) return 1 ;;
    esac
    [ "$port" -ge 1 ] && [ "$port" -le 65535 ] || return 1

    procd_open_instance
    procd_set_param command /usr/bin/homebox serve --host "$host" --port "$port"
    procd_set_param respawn 3600 5 5
    procd_set_param stdout 1
    procd_set_param stderr 1
    procd_close_instance
}

service_triggers() {
    procd_add_reload_trigger homebox
}
