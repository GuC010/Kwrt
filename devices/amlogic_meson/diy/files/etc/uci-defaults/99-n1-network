#!/bin/sh
# One-time first-boot configuration for the user's Phicomm N1 side router.
# This script is intentionally conservative: it keeps the main router at .253,
# makes N1 static at .251, and leaves DHCP distribution to the main router.

[ -x /sbin/uci ] || exit 0

uci -q batch <<'EOF'
set network.lan.proto='static'
set network.lan.ipaddr='192.168.10.251'
set network.lan.netmask='255.255.255.0'
set network.lan.gateway='192.168.10.253'
delete network.lan.dns
add_list network.lan.dns='223.5.5.5'
add_list network.lan.dns='119.29.29.29'
set dhcp.lan.ignore='1'
commit network
commit dhcp
set luci.main.mediaurlbase='/luci-static/vantage'
commit luci
EOF

# Homebox's LuCI controller registers its menu only when /etc/config/homebox exists.
# Keep the service disabled on first boot; the user can enable it after configuring it.
if [ ! -f /etc/config/homebox ]; then
    cat > /etc/config/homebox <<'HOMEBOX_EOF'
config homebox 'homebox'
        option enabled '0'
        option host '192.168.10.251'
        option port '3300'
HOMEBOX_EOF
fi

[ -x /etc/init.d/homebox ] && /etc/init.d/homebox enable

exit 0
