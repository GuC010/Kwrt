
CONFIG_TARGET_amlogic=y
CONFIG_TARGET_amlogic_meson=y
CONFIG_TARGET_MULTI_PROFILE=y
CONFIG_TARGET_ALL_PROFILES=y

CONFIG_PACKAGE_kmod-pcie_mhi=n

# BEGIN N1-HONK-ACTIONS
# Phicomm N1: force SquashFS rootfs. Do not enable EXT4 for this build.
CONFIG_TARGET_ROOTFS_EXT4FS=n
CONFIG_TARGET_ROOTFS_SQUASHFS=y

# Honk eBPF needs kernel BTF. The vmlinux-btf-builtin package supplies
# the vmlinux-btf dependency only when /sys/kernel/btf/vmlinux exists.
CONFIG_KERNEL_DEBUG_INFO=y
CONFIG_KERNEL_DEBUG_INFO_BTF=y
CONFIG_KERNEL_DEBUG_INFO_REDUCED=n

# Honk core + LuCI page + shared LuCI library + built-in BTF provider.
CONFIG_PACKAGE_honk=y
CONFIG_PACKAGE_luci-app-honk=y
CONFIG_PACKAGE_luci-lib-daeuniverse=y
CONFIG_PACKAGE_vmlinux-btf-builtin=y
CONFIG_PACKAGE_v2ray-geoip=y
CONFIG_PACKAGE_v2ray-geosite=y
# END N1-HONK-ACTIONS
# BEGIN N1 FINAL UI, THEMES AND SERVICES
# Web UI server: build into firmware so LuCI is available on first boot.
CONFIG_PACKAGE_uhttpd=y
CONFIG_PACKAGE_uhttpd-mod-ubus=y
CONFIG_PACKAGE_uhttpd-mod-ucode=y

# Standard LuCI sections (network, system and status).
CONFIG_PACKAGE_luci-base=y
CONFIG_PACKAGE_luci-compat=y
CONFIG_PACKAGE_luci-mod-network=y
CONFIG_PACKAGE_luci-mod-system=y
CONFIG_PACKAGE_luci-mod-status=y

# Retain the currently used Vantage dashboard/theme and installed themes.
CONFIG_PACKAGE_luci-app-vantage=y
CONFIG_PACKAGE_luci-theme-vantage=y
CONFIG_PACKAGE_luci-theme-footstrap=y
CONFIG_PACKAGE_luci-theme-alpha=y
CONFIG_PACKAGE_luci-theme-argon=y
CONFIG_PACKAGE_luci-theme-bootstrap=y

# Retain the currently installed LuCI utilities and add-ons.
CONFIG_PACKAGE_luci-app-advancedplus=y
CONFIG_PACKAGE_luci-app-alpha-config=y
CONFIG_PACKAGE_luci-app-crontab-wizard=y
CONFIG_PACKAGE_luci-app-diskman=y
CONFIG_PACKAGE_luci-app-fan=y
CONFIG_PACKAGE_luci-app-firewall=y
CONFIG_PACKAGE_luci-app-footstrap-files=y
CONFIG_PACKAGE_luci-app-honk=y
CONFIG_PACKAGE_luci-app-oui=y
CONFIG_PACKAGE_luci-app-package-manager=y
CONFIG_PACKAGE_luci-app-partexp=y
CONFIG_PACKAGE_luci-app-syscontrol=y
CONFIG_PACKAGE_luci-app-sysctl=y
CONFIG_PACKAGE_luci-app-upnp=n
CONFIG_PACKAGE_luci-app-wifihistory=y
CONFIG_PACKAGE_luci-app-wizard=y

# Requested service applications.
CONFIG_PACKAGE_luci-app-openclash=y
CONFIG_PACKAGE_luci-app-passwall2=y
CONFIG_PACKAGE_luci-app-nikki=y
CONFIG_PACKAGE_luci-app-clashoo=y
CONFIG_PACKAGE_luci-app-homebox=y
CONFIG_PACKAGE_luci-app-fastnet=y

# Explicit backend/runtime packages required by the requested applications.
CONFIG_PACKAGE_clashoo=y
CONFIG_PACKAGE_nikki=y
CONFIG_PACKAGE_homebox=y
CONFIG_PACKAGE_fastnet=y
CONFIG_PACKAGE_linkease-app-entry=y
CONFIG_PACKAGE_luci-lib-linkeaseauth=y

# PassWall 2: select Xray only to avoid adding a second large core by default;
# use nftables transparent proxy mode for the OpenWrt 25.12 firewall4 stack.
CONFIG_PACKAGE_luci-app-passwall2_Basic_Core_Xray=y
CONFIG_PACKAGE_luci-app-passwall2_Nftables_Transparent_Proxy=y

# Retain the Netdata monitor already tested on the USB system.
CONFIG_PACKAGE_netdata=y
CONFIG_PACKAGE_luci-app-netdata=y
CONFIG_PACKAGE_protobuf=y
CONFIG_PACKAGE_protobuf-lite=y
CONFIG_PACKAGE_libatomic=y

# Common proxy prerequisites for the requested apps.
CONFIG_PACKAGE_dnsmasq-full=y
CONFIG_PACKAGE_firewall4=y
CONFIG_PACKAGE_ip-full=y
CONFIG_PACKAGE_kmod-inet-diag=y
CONFIG_PACKAGE_kmod-nft-socket=y
CONFIG_PACKAGE_kmod-nft-tproxy=y
CONFIG_PACKAGE_kmod-tun=y
CONFIG_PACKAGE_kmod-dummy=y
# END N1 FINAL UI, THEMES AND SERVICES
